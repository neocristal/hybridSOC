# HybridSOC API Configuration Template
# 1. Copy this file to '.env' in the same directory: cp .env.example .env
# 2. Fill in the required values. DO NOT commit the .env file to version control.

# --- Database ---
SQLITE_DB_PATH=./hybridsoc.db

# --- Superadmin bootstrap ---
SUPERADMIN_EMAIL=superadmin@hybridsoc.example.com
# PRIVALOMA: Įrašykite stiprų slaptažodį (sistema nepasileis be jo)
SUPERADMIN_PASSWORD=
ACCESS_TOKEN_TTL_MINUTES=60

# --- SMTP for email OTP delivery ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer_user
SMTP_PASSWORD=
SMTP_FROM=noreply@hybridsoc.local
SMTP_TLS=true

# --- IAM integrations ---
VAULT_ADDR=http://vault:8200
VAULT_ROLE=hybridsoc-pam
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=hybridsoc

# --- Vidinis raktas ---
# Sugeneruokite su: openssl rand -hex 32
INTERNAL_AUTH_SECRET=

# --- Infrastruktūra ---
REDIS_URL=redis://redis:6379/0

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,https://dashboard.hybridsoc.ai
