# HybridSOC API Configuration Template
# 1. Copy this file to '.env' in the same directory: cp .env.example .env
# 2. Fill in the required values. DO NOT commit the .env file to version control.

# --- Autentifikacija ---
SUPERADMIN_EMAIL=admin@hybridsoc.ai
# PRIVALOMA: Įrašykite stiprų slaptažodį (sistema nepasileis be jo)
SUPERADMIN_PASSWORD=

# --- Vidinis raktas ---
# Sugeneruokite su: openssl rand -hex 32
INTERNAL_AUTH_SECRET=

# --- Infrastruktūra ---
REDIS_URL=redis://redis:6379/0
VAULT_ADDR=http://vault:8200
VAULT_ROLE=hybridsoc-pam

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,https://dashboard.hybridsoc.ai
